APP_DISPLAY_NAME = Duskling
APP_BUNDLE_ID = io.github.hamzic.dusk
APP_GROUP_ID = group.io.github.hamzic.dusk
REPORT_EMAIL = developer@defec8ed.com
// "//" starts a comment in an xcconfig, so the empty $() splits it (verified by BrandRepoTests).
REPO_URL = https:/$()/github.com/hamzic/duskling
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 2
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
// The app's Debug entitlements (project.yml). Signing.local.xcconfig may override it, e.g. for a free personal team.
DUSK_APP_ENTITLEMENTS = App/Dusk.debug.entitlements
#include? "Signing.local.xcconfig"
